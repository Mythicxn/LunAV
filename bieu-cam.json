        {
          "vi": "Ưm, được rồi đấy, xoa nữa đi~",
          "en": "Mmm, that's it, pat me some more~"
        },
        {
          "vi": "Ơ, ai xoa đầu mình vậy, thích ghê~",
          "en": "Ooh, who's patting my head, I love it~"
        }
      ],
      "2": [
        {
          "vi": "Hihi, vui muốn bay lên luôn á~",
          "en": "Hehe, I'm so happy I could float away~"
